# Godot 4 import cache
.godot/

# Export artifacts
build/
export/
*.pck
*.zip

# Windows shortcuts (machine-local; point at gitignored build/ launcher)
*.lnk

# Shared contract junctions (created by scripts/link_shared.ps1)
client/shared
server/shared

# Runtime SQLite database (lives under user://, never in the repo)
*.db
*.db-wal
*.db-shm

# Per-worktree local state (isolated ports/DBs; never committed)
.local/

# Agent Manager managed worktrees (owned by the tool, not the repo)
.kilo/worktrees/**
