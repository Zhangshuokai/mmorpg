{
  "table": "items",
  "version": 1,
  "comment": "WB3 static item definitions (S-G-5). Values are data, not code: kind uses Protocol.ItemKind and equip_slot uses Protocol.EquipSlot. `max_stack` is bounded by Protocol.ITEM_STACK_MAX; `bind` is bind-on-pickup/on-equip; `stats` keys are the Protocol.Stat names. Runtime ownership (slots/equipment) lives in the DB, never here.",
  "primary_key": "id",
  "fields": {
    "id": {"type": "string", "min_length": 1, "max_length": 64},
    "name": {"type": "string", "min_length": 1, "max_length": 64},
    "kind": {"type": "int", "enum": [1, 2, 3, 4]},
    "rarity": {"type": "string", "enum": ["common", "uncommon", "rare", "epic", "legendary"]},
    "max_stack": {"type": "int", "min": 1, "max": 999},
    "bind": {"type": "bool"},
    "equip_slot": {"type": "int", "enum": [0, 1, 2, 3, 4, 5], "nullable": true},
    "stats": {
      "type": "object",
      "fields": {
        "strength": {"type": "int", "min": -100, "max": 100, "required": false},
        "agility": {"type": "int", "min": -100, "max": 100, "required": false},
        "stamina": {"type": "int", "min": -100, "max": 100, "required": false},
        "intellect": {"type": "int", "min": -100, "max": 100, "required": false}
      }
    }
  },
